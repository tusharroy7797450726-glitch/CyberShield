from kivy.app import App
from kivy.core.window import Window
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.gridlayout import GridLayout
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.uix.scrollview import ScrollView
import socket, hashlib, urllib.request, random, string

Window.clearcolor = (0.05, 0.08, 0.14, 1)

class CyberShieldApp(App):
    def build(self):
        root = BoxLayout(orientation='vertical', padding=18, spacing=12)

        header = BoxLayout(orientation='vertical', size_hint_y=0.14)
        header.add_widget(Label(
            text="[b]CYBERSHIELD PRO[/b]",
            markup=True, font_size='24sp', color=(0.0, 0.9, 1.0, 1)
        ))
        header.add_widget(Label(
            text="All-in-One Security & Network Toolkit",
            font_size='12sp', color=(0.6, 0.7, 0.8, 1)
        ))
        root.add_widget(header)

        self.input_box = TextInput(
            hint_text="Enter IP, Domain, URL or Text...",
            multiline=False, font_size='15sp', size_hint_y=0.1,
            background_color=(0.12, 0.16, 0.24, 1),
            foreground_color=(1, 1, 1, 1),
            hint_text_color=(0.5, 0.6, 0.7, 1),
            padding=[12, 12]
        )
        root.add_widget(self.input_box)

        grid = GridLayout(cols=2, spacing=10, size_hint_y=0.38)
        tools = [
            ("Port Scanner", self.run_port_scan, (0.0, 0.45, 0.75, 1)),
            ("Subdomain Finder", self.run_subdomain, (0.0, 0.55, 0.65, 1)),
            ("Web Security", self.run_web_check, (0.15, 0.4, 0.8, 1)),
            ("Phishing Check", self.run_phishing, (0.75, 0.25, 0.3, 1)),
            ("SHA-256 Hash", self.run_hasher, (0.2, 0.55, 0.45, 1)),
            ("Pass Generator", self.run_pass_gen, (0.45, 0.35, 0.75, 1))
        ]
        for title, action, clr in tools:
            btn = Button(
                text=title, font_size='14sp', bold=True,
                background_normal='', background_color=clr
            )
            btn.bind(on_press=action)
            grid.add_widget(btn)
        root.add_widget(grid)

        scroll = ScrollView(size_hint_y=0.38)
        self.output_label = Label(
            text="> System Ready. Enter target above and select a tool...",
            size_hint_y=None, font_size='14sp',
            color=(0.2, 1.0, 0.5, 1), halign='left', valign='top'
        )
        self.output_label.bind(texture_size=self.output_label.setter('size'))
        self.output_label.bind(width=lambda *x: self.output_label.setter('text_size')(self.output_label, (self.output_label.width, None)))
        scroll.add_widget(self.output_label)
        root.add_widget(scroll)

        return root

    def run_port_scan(self, instance):
        target = self.input_box.text.strip() or "127.0.0.1"
        res = f"[SCANNING TARGET: {target}]\n"
        for port in [21, 22, 80, 443, 5555, 8080]:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(0.4)
            status = "OPEN" if s.connect_ex((target, port)) == 0 else "CLOSED"
            res += f"  Port {port:<5} : {status}\n"
            s.close()
        self.output_label.text = res

    def run_subdomain(self, instance):
        domain = self.input_box.text.strip() or "google.com"
        res = f"[SUBDOMAINS FOR: {domain}]\n"
        for sub in ["www", "mail", "drive", "maps", "admin", "test"]:
            try:
                ip = socket.gethostbyname(f"{sub}.{domain}")
                res += f"  {sub}.{domain} -> {ip}\n"
            except:
                pass
        self.output_label.text = res

    def run_web_check(self, instance):
        url = self.input_box.text.strip()
        if not url.startswith("http"):
            self.output_label.text = "> Error: Start URL with https://"
            return
        try:
            headers = urllib.request.urlopen(url).headers
            cj = "Protected" if "X-Frame-Options" in headers else "Vulnerable (No X-Frame)"
            hsts = "Active" if "Strict-Transport-Security" in headers else "Missing"
            self.output_label.text = f"[WEB SECURITY REPORT]\n  Clickjacking : {cj}\n  HSTS Policy  : {hsts}"
        except:
            self.output_label.text = "> Connection Failed! Check URL."

    def run_phishing(self, instance):
        link = self.input_box.text.lower()
        if not link:
            self.output_label.text = "> Paste a link first to scan!"
            return
        bad_words = ["free", "win", "prize", "login", "verify", "bank", "gift", "bit.ly"]
        score = (0 if link.startswith("https://") else 1) + sum(1 for w in bad_words if w in link)
        self.output_label.text = "[ALERT] High Phishing Risk Detected!" if score >= 2 else "[SAFE] Link appears normal."

    def run_hasher(self, instance):
        txt = self.input_box.text
        if txt:
            h = hashlib.sha256(txt.encode()).hexdigest()
            self.output_label.text = f"[SHA-256 HASH]\n{h[:32]}\n{h[32:]}"
        else:
            self.output_label.text = "> Type text or password to hash!"

    def run_pass_gen(self, instance):
        chars = string.ascii_letters + string.digits + "!@#$%^&*"
        pwd = "".join(random.choice(chars) for _ in range(14))
        self.output_label.text = f"[GENERATED STRONG PASSWORD]\n  {pwd}"

if __name__ == "__main__":
    CyberShieldApp().run()
